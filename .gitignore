apps/mobile/public/icons/generated/

# Runtime
*.tmp
*.bak

# Local dev config for bare `cargo run` (template: config.local.toml.example)
apps/pairing-server/config.local.toml
apps/target-itest/

# Dev database (tasks.json dev:pairing-server env DATABASE_URL)
apps/pairing-server/dev.db
