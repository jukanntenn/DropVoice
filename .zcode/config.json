{
  "hooks": {
    "enabled": true,
    "events": {
      "PostToolUse": [
        {
          "matcher": "Edit|Write|ApplyPatch",
          "hooks": [
            {
              "type": "command",
              "command": "python \"${ZCODE_PROJECT_DIR}/.zcode/hooks/post_tool_use.py\"",
              "timeout": 120
            }
          ]
        }
      ],
      "Stop": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "python \"${ZCODE_PROJECT_DIR}/.zcode/hooks/stop.py\"",
              "timeout": 240
            }
          ]
        }
      ]
    }
  }
}
