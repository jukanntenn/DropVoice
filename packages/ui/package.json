{
  "name": "@dropvoice/ui",
  "version": "0.1.0-rc.2",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tokens/theme.css": "./src/tokens/theme.css",
    "./tokens/effects.css": "./src/tokens/effects.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src/",
    "lint:fix": "oxlint src/ --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\" \"!src/tokens/theme.css\" \"tests/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,css}\" \"!src/tokens/theme.css\" \"tests/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@dropvoice/core": "workspace:*",
    "@fontsource/inter": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.0.0",
    "jotai": "^2.18.0",
    "lucide-react": "^0.511.0",
    "qrcode.react": "^4.2.0",
    "react-i18next": "^16.5.0",
    "sonner": "^2.0.0",
    "tailwind-merge": "^3.5.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^25.0.0",
    "oxlint": "^0.15.0",
    "prettier": "^3.6.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  }
}
