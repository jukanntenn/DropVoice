{
  "name": "@dropvoice/i18n",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./locales/*": "./locales/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src/",
    "lint:fix": "oxlint src/ --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json}\" \"locales/**/*.json\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json}\" \"locales/**/*.json\""
  },
  "dependencies": {
    "i18next": "^25.8.0",
    "react-i18next": "^16.5.0",
    "i18next-browser-languagedetector": "^8.0.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  }
}
