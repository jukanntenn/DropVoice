# DropVoice pairing-server Caddyfile — local acceptance variant (plain HTTP).
#
# Mounted into the container by docker/docker-compose.local.yml (and e2e).
# Local acceptance runs plain HTTP on :8080 — no TLS on the local box
# (tunnel / Cloudflare terminate TLS in deployed forms). Same routing logic as
# the baked default (docker/Caddyfile) and the deployed templates
# (Caddyfile.staging / Caddyfile.production.j2); only the TLS layer differs.
#
# Production form (§10.4): one origin serves both the mobile PWA and the
# WebRTC signaling API. Internal layout:
#   :8080  Caddy (this file)             — published on the host
#   127.0.0.1:38424 Rust axum backend    — loopback only, never published

{
	auto_https off
}

:8080 {
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	encode zstd gzip

	# PWA hashed assets: immutable, long cache.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		root * /app/mobile-dist
		file_server
	}

	# PWA entry + service worker: no-cache.
	handle /index.html {
		header Cache-Control "no-cache"
		root * /app/mobile-dist
		file_server
	}

	handle /sw.js {
		header Cache-Control "no-cache"
		root * /app/mobile-dist
		file_server
	}

	# WebRTC signaling API（§4.1：/api/* 前缀）+ 健康检查。
	handle /api/* {
		header Cache-Control "no-store"
		reverse_proxy 127.0.0.1:38424
	}

	handle /health {
		header Cache-Control "no-store"
		reverse_proxy 127.0.0.1:38424
	}

	# Fallback: everything else is PWA static files.
	handle {
		root * /app/mobile-dist
		file_server
	}

	log {
		output stderr
		format console
	}
}
