# DropVoice pairing-server Environment Variables
# Copy this file to .env and edit as needed.

# ── Host ──
# Host port mapped to the container's Caddy :8080 (HTTP self-hosted form).
PAIRING_PORT=8080

# ── Logging ──
# Log level (default: info). The pairing-server JSON daily log lands in ./log.
RUST_LOG=info

# ── Rate limiting ──
# Per-IP requests per second (default: 1). Raise for acceptance / load tests.
# RATE_LIMIT_PER_SEC=10000

# ── Database ──
# SQLite is fixed at /app/data/pairing.db inside the container
# (dropvoice-data volume) via DATABASE_URL in docker-compose.yml — nothing to
# set here. The volume is never published on the host.
