# DropVoice pairing-server — host-side environment (docker compose 插值).
# Copy this file to .env and edit as needed（都有默认值，可不复制）.
#
# 应用行为（限流 / Swagger / CORS / 数据库路径）不在 env —— 在 config.toml：
#   cp config.example.toml config.toml

# 宿主发布端口（容器内 Caddy 固定 :8080）
PAIRING_PORT=8080

# 日志级别（默认 info；JSON 日志落在 ./log）
RUST_LOG=info
