# DropVoice pairing-server Caddyfile — image-baked default (HTTP, self-hosted form).
#
# This file is the baked default; TLS variants are selected at runtime via a
# volume mount over /etc/caddy/Caddyfile:
#   - local acceptance (self-signed HTTPS): docker/Caddyfile.local
#   - staging (tunnel-terminated HTTPS):    devops/ansible/templates/Caddyfile.staging
#   - production (Cloudflare Origin CA):    devops/ansible/templates/Caddyfile.production.j2
# All share the same routing logic; only the TLS layer differs.
#
# Production form (§10.4): one origin serves both the mobile PWA (baked into
# the image at /app/mobile-dist) and the WebRTC signaling API, so the phone
# browser is same-origin (no CORS). Internal layout:
#   :8080  Caddy (this file)              — the only published port
#   127.0.0.1:38424 Rust axum backend     — loopback only, never published

{
	auto_https off
}

:8080 {
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	encode zstd gzip

	# PWA hashed assets: immutable, long cache.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		root * /app/mobile-dist
		file_server
	}

	# PWA entry + service worker: no-cache.
	handle /index.html {
		header Cache-Control "no-cache"
		root * /app/mobile-dist
		file_server
	}

	handle /sw.js {
		header Cache-Control "no-cache"
		root * /app/mobile-dist
		file_server
	}

	# WebRTC signaling API（§4.1：/api/* 前缀）+ 健康检查。
	handle /api/* {
		header Cache-Control "no-store"
		reverse_proxy 127.0.0.1:38424
	}

	handle /health {
		header Cache-Control "no-store"
		reverse_proxy 127.0.0.1:38424
	}

	# Fallback: everything else is PWA static files.
	handle {
		root * /app/mobile-dist
		file_server
	}

	log {
		output stderr
		format console
	}
}
