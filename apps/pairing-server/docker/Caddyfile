# DropVoice pairing-server Caddyfile — HTTP form (the routing single source).
#
# Used AS-IS by three environments (all plain HTTP :8080 — TLS is always
# terminated externally, the container never does TLS):
#   - image default: baked at /etc/caddy/Caddyfile by the Dockerfile
#   - local acceptance: mounted by docker/docker-compose.local.yml
#   - staging: copied by the ansible playbook (tunnel terminates HTTPS)
# The only other variant is the TLS form (production, Cloudflare Origin CA,
# devops/ansible/templates/Caddyfile.production.j2) — its routing mirrors this
# file; change routing here and mirror it there.
#
# Production form (§10.4): one origin serves both the mobile PWA (baked into
# the image at /app/mobile-dist) and the WebRTC signaling API, so the phone
# browser is same-origin (no CORS). Internal layout:
#   :8080  Caddy (this file)              — the only published port
#   127.0.0.1:38424 Rust axum backend     — loopback only, never published

{
	auto_https off
}

:8080 {
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	encode zstd gzip

	# PWA hashed assets: immutable, long cache.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		root * /app/mobile-dist
		file_server
	}

	# PWA entry + service worker: no-cache.
	handle /index.html {
		header Cache-Control "no-cache"
		root * /app/mobile-dist
		file_server
	}

	handle /sw.js {
		header Cache-Control "no-cache"
		root * /app/mobile-dist
		file_server
	}

	# WebRTC signaling API（§4.1：/api/* 前缀）+ 健康检查。
	handle /api/* {
		header Cache-Control "no-store"
		reverse_proxy 127.0.0.1:38424
	}

	handle /health {
		header Cache-Control "no-store"
		reverse_proxy 127.0.0.1:38424
	}

	# Fallback: everything else is PWA static files.
	handle {
		root * /app/mobile-dist
		file_server
	}

	log {
		output stderr
		format console
	}
}
