# systemd 服务配置（spec 11 §12.6）。
# 部署：cp 到 /etc/systemd/system/，systemctl enable --now dropvoice-pairing

[Unit]
Description=DropVoice Pairing Server
After=network.target

[Service]
Type=simple
User=dropvoice
Group=dropvoice
WorkingDirectory=/opt/dropvoice
Environment="LISTEN_ADDR=127.0.0.1:38424"
Environment="DATABASE_URL=sqlite:////opt/dropvoice/data/pairing.db?mode=rwc"
Environment="LOG_DIR=/opt/dropvoice/logs"
Environment="RUST_LOG=info,dropvoice_pairing_server=debug"
ExecStart=/opt/dropvoice/pairing-server
Restart=always
RestartSec=5
LimitNOFILE=65536

# 安全加固
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/dropvoice
PrivateTmp=true

[Install]
WantedBy=multi-user.target
