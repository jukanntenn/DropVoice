# 本地 e2e/压测 Caddyfile（spec 11 §13.1）。
# 与生产 Caddyfile 结构镜像，唯一差异：TLS 用自签（tls internal）。
# 生产用 Cloudflare Origin 证书，本地用 Caddy 内置 CA 自签。

api.dropvoice.test {
	# 与生产一致：监听 8443
	bind 0.0.0.0 8443

	# 与生产完全相同的 API 反代
	handle /devices/* {
		reverse_proxy pairing-server:38424
	}
	handle /pairing-codes/* {
		reverse_proxy pairing-server:38424
	}
	handle {
		reverse_proxy pairing-server:38424
	}

	# 与生产一致：gzip
	encode gzip

	# 唯一差异：自签证书（生产用 Cloudflare Origin 证书）
	tls internal
}
