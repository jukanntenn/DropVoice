# {{ ansible_managed }}
# dropvoice pairing-server Caddyfile (production).
#
# Production form (webrtc-scan-direct-design §10.4): one origin serves both the
# mobile PWA and the WebRTC signaling API (same-origin, no CORS for the phone).
#
# Cloudflare Origin CA certificate (Full strict mode). Cloudflare terminates
# visitor-side TLS at the edge; Caddy terminates the edge→origin leg. The cert
# is mounted at /app/certs/ from the host certs/ directory.
#
# trusted_proxies: Cloudflare's published CIDR ranges so only Cloudflare (a
# trusted peer) may prepend to X-Forwarded-For. Direct connections have their
# XFF overwritten by Caddy, closing the spoofing gap (spec 11 §6.1.3).
# Source: https://www.cloudflare.com/ips/ — sync when Cloudflare updates.
# Internal layout: Caddy :4443, backend 127.0.0.1:38424.
{
	auto_https off
}

:4443 {
	tls /app/certs/origin.pem /app/certs/origin.key

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	encode zstd gzip

	# PWA hashed assets: immutable, long cache.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		root * /app/mobile-dist
		file_server
	}

	# PWA entry + service worker: no-cache.
	handle /index.html {
		header Cache-Control "no-cache"
		root * /app/mobile-dist
		file_server
	}

	handle /sw.js {
		header Cache-Control "no-cache"
		root * /app/mobile-dist
		file_server
	}

	# WebRTC signaling API（§4.1：/api/* 前缀）+ 健康检查。
	handle /api/* {
		header Cache-Control "no-store"
		reverse_proxy 127.0.0.1:38424 {
			trusted_proxies {{ cloudflare_cidrs }}
			header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
		}
	}

	handle /health {
		header Cache-Control "no-store"
		reverse_proxy 127.0.0.1:38424 {
			trusted_proxies {{ cloudflare_cidrs }}
			header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
		}
	}

	# Fallback: everything else is PWA static files.
	handle {
		root * /app/mobile-dist
		file_server
	}

	log {
		output stderr
		format console
	}
}
