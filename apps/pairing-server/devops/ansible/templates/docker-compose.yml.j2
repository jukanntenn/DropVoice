# {{ ansible_managed }}
# dropvoice pairing-server docker-compose (rendered for {{ env }}).
#
# Topology is identical across staging / production: a single container
# (s6-overlay supervising Caddy + the Rust axum backend). The SQLite database
# is bind-mounted from the deployment dir's data/ subdirectory (not a named
# volume), so the whole deployment — compose, config, data, log — is one plain
# directory tree and backup is a single tar (stop the container first for a
# consistent snapshot). Caddy serves plain HTTP in every environment — TLS is
# terminated upstream (staging: intranet tunnel; production: the shared host
# Caddy that Cloudflare reaches on :443, reverse-proxying to this container's
# loopback-only published port). The only per-environment difference is the
# published host port. The mobile PWA is baked into the image at
# /app/mobile-dist — no uploads, no host-side dist volume. Rolling JSON logs
# are bind-mounted in every environment.
#
# Application config (listen addr / DB / rate limit / CORS) is rendered into
# config.toml by the playbook and mounted at /app/config.toml; this compose
# keeps only RUST_LOG / LOG_DIR as environment (runtime concerns).
services:
  {{ app_name }}:
    image: {{ image }}
    container_name: {{ app_name }}
    ports:
      - "{{ host_port }}:{{ caddy_port }}"
    volumes:
      - {{ caddyfile }}:/etc/caddy/Caddyfile:ro
      - {{ config_file }}:/app/config.toml:ro
      - {{ app_path }}/log:/app/log
      - {{ app_path }}/data:/app/data
    environment:
      - LOG_DIR=/app/log
      - RUST_LOG={{ 'info,dropvoice_pairing_server=debug' if debug else 'info' }}
    healthcheck:
      test:
        - CMD
        - curl
        - -f
        - "http://127.0.0.1:{{ caddy_port }}/health"
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 15s
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    restart: always
