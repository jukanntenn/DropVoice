# {{ ansible_managed }}
# dropvoice pairing-server Caddyfile (staging).
#
# Production form (webrtc-scan-direct-design §10.4): one origin serves both the
# mobile PWA and the WebRTC signaling API. Plain HTTP (no TLS) for staging —
# HTTPS is terminated externally (tunnel / public proxy). Internal layout:
# Caddy :8080, backend loopback.
{
	auto_https off
}

:8080 {
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	encode zstd gzip

	# PWA hashed assets: immutable, long cache.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		root * /app/mobile-dist
		file_server
	}

	# PWA entry + service worker: no-cache.
	handle /index.html {
		header Cache-Control "no-cache"
		root * /app/mobile-dist
		file_server
	}

	handle /sw.js {
		header Cache-Control "no-cache"
		root * /app/mobile-dist
		file_server
	}

	# WebRTC signaling API（§4.1：/api/* 前缀）+ 健康检查。
	handle /api/* {
		header Cache-Control "no-store"
		reverse_proxy 127.0.0.1:38424
	}

	handle /health {
		header Cache-Control "no-store"
		reverse_proxy 127.0.0.1:38424
	}

	# Fallback: everything else is PWA static files.
	handle {
		root * /app/mobile-dist
		file_server
	}

	log {
		output stderr
		format console
	}
}
