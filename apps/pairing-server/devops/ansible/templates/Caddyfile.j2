# {{ ansible_managed }}
# dropvoice pairing-server Caddyfile — 单一 HTTP 形态，TLS 恒由外部终结：
#   staging    内网隧道（TLS 在隧道外终结）
#   production ttyo 宿主共享 Caddy（Cloudflare 回源 :443，宿主 Caddy 反代到
#              容器 127.0.0.1:{{ host_port }}；markpost 模式）
# 三站点按 Host 分流，与生产域名一一映射：
#   landing_domain  营销页（landing-dist）
#   app_domain      手机 PWA（mobile-dist）+ /api 同源反代（PWA 与 API 恒同源）
#   api_domain      纯 API（桌面心跳/SSE；跨域 CORS 已由 tauri origin 白名单覆盖）
# 加 <port> 兜底块仅供容器 healthcheck（127.0.0.1 无 Host 匹配时命中）。
#
# 真实客户端 IP 链（B 方案）：servers.trusted_proxies（上游代理段，per-env 的
# trusted_proxies_cidrs：staging=隧道网关，production=宿主 Caddy 经 docker 网桥）
# + trusted_proxies_strict（从右往左信任链解析）+ header_up X-Forwarded-For
# {client_ip}——axum 恒取 XFF 最左段即真实客户端 IP；未受信直连者的 XFF 被
# Caddy 覆盖为其真实 IP（伪造免疫），且访问日志的 client_ip 字段自动有值。
# 内部布局：Caddy {{ caddy_port }}（唯一发布端口），backend 127.0.0.1:{{ backend_port }}。
{
	auto_https off
	servers {
		trusted_proxies static {{ trusted_proxies_cidrs }}
		trusted_proxies_strict
	}
}

# ── 站点 1：landing（营销页）───────────────────────────────────────────────
# 注意：Caddy ≥2.10 起，无 scheme 的站点地址即使非标准端口也默认 HTTPS（旧版
# 默认 HTTP 的破坏性变更），明文请求会被 400 "Client sent an HTTP request to
# an HTTPS server" 拒绝——本文件恒为 HTTP 形态，所有站点必须显式 http:// 前缀。
http://{{ landing_domain }}:{{ caddy_port }} {
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	encode zstd gzip

	# 哈希资产：immutable 长缓存（经 Cloudflare 边缘缓存，源站 3Mbps 只付回源）。
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		root * /app/landing-dist
		file_server
	}

	# HTML 入口：no-cache（HTML 永不进边缘缓存是域名方案的前提）。
	handle {
		header Cache-Control "no-cache"
		root * /app/landing-dist
		file_server
	}

	log {
		output stderr
		format console
	}
}

# ── 站点 2：app（手机 PWA + /api 同源）────────────────────────────────────
http://{{ app_domain }}:{{ caddy_port }} {
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	encode zstd gzip

	# PWA 哈希资产：immutable，长缓存。
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		root * /app/mobile-dist
		file_server
	}

	# PWA 入口 + service worker：no-cache。
	handle /index.html {
		header Cache-Control "no-cache"
		root * /app/mobile-dist
		file_server
	}

	handle /sw.js {
		header Cache-Control "no-cache"
		root * /app/mobile-dist
		file_server
	}

	# WebRTC 信令 API + 健康检查（§4.1：/api/* 前缀）。
	handle /api/* {
		header Cache-Control "no-store"
		reverse_proxy 127.0.0.1:{{ backend_port }} {
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle /health {
		header Cache-Control "no-store"
		reverse_proxy 127.0.0.1:{{ backend_port }} {
			header_up X-Forwarded-For {client_ip}
		}
	}

	# 其余路径 = PWA 静态文件。
	handle {
		root * /app/mobile-dist
		file_server
	}

	log {
		output stderr
		format console
	}
}

# ── 站点 3：ps（纯 API，桌面端）───────────────────────────────────────────
http://{{ api_domain }}:{{ caddy_port }} {
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	encode zstd gzip

	handle /api/* {
		header Cache-Control "no-store"
		reverse_proxy 127.0.0.1:{{ backend_port }} {
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle /health {
		header Cache-Control "no-store"
		reverse_proxy 127.0.0.1:{{ backend_port }} {
			header_up X-Forwarded-For {client_ip}
		}
	}

	# 机器 API 域名：其余路径一律 404（不发任何静态内容）。
	respond 404

	log {
		output stderr
		format console
	}
}

# ── 兜底块：容器 healthcheck（127.0.0.1 无 Host 匹配时命中此块）──────────
http://127.0.0.1:{{ caddy_port }} {
	handle /health {
		reverse_proxy 127.0.0.1:{{ backend_port }}
	}

	respond 404
}
